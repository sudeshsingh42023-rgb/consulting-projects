<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="liquidity_dashboard.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="800"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="bucket_rules - bucket_rules" custom_title="0" dock_id="1" table="4,27:mainbucket_rules - bucket_rules"/><dock_state state="000000ff00000000fd00000001000000020000033b0000026efc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000033b0000011e00ffffff000002710000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="assets - assets" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="300"/><column index="2" value="124"/><column index="3" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="bucket_rules - bucket_rules" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="148"/><column index="2" value="78"/><column index="3" value="93"/><column index="4" value="68"/><column index="5" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="liabilities - liabilities" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="296"/><column index="2" value="148"/><column index="3" value="54"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT 
    (SELECT SUM(l.&quot;Amount&quot; * b.&quot;Factor_pct&quot; / 100.0)
     FROM &quot;liabilities - liabilities&quot; l 
     JOIN &quot;bucket_rules - bucket_rules&quot; b 
       ON l.&quot;Category&quot; = b.&quot;Category&quot; AND b.&quot;Factor_type&quot; = 'ASF_pct')
    /
    (SELECT SUM(a.&quot;Amount&quot; * b.&quot;Factor_pct&quot; / 100.0)
     FROM &quot;assets - assets&quot; a 
     JOIN &quot;bucket_rules - bucket_rules&quot; b 
       ON a.&quot;Category&quot; = b.&quot;Category&quot; AND b.&quot;Factor_type&quot; = 'RSF_pct')
    * 100 AS NSFR_percent;</sql><current_tab id="0"/></tab_sql></sqlb_project>
